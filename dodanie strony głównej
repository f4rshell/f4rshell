            margin: 0 15px;
            text-decoration: none;
            font-weight: 600;
        }
        .social-links a:hover {
            text-shadow: 0 0 10px #00ffff;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }
        @keyframes bounce {
            0% { transform: translateY(0); }
            100% { transform: translateY(-15px); }
        }

        @media (max-width: 768px) {
